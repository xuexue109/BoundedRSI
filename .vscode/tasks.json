{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BoundedRSI: Run pilot",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "boundedrsi", "pilot", "--out", "${input:runOutput}"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "BoundedRSI: Tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "test",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {"id": "runOutput", "type": "promptString", "description": "New output directory (must not already contain results)", "default": "artifacts/pilot-v2"}
  ]
}
